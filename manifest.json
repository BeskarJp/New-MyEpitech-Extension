{
  "manifest_version": 3,
  "name": "MyEpitech-Extension",
  "version": "1.2",
  "description": "Add automaticaly the percent of tests results in my.epitech.eu.",
  "author": "BeskarJp",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://my.epitech.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
